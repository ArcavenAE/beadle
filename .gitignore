# beadle out-of-band state store (Phase 0 JSONL) and caches — never committed
.beadle/state/
.beadle/cache/
*.local

# Rust build output
/target/

# Local target-observation JSONL (live state, not source of truth)
/store/

# rendered docs
/tmp/beadle-*

# editor / OS
.DS_Store
*.swp
.idea/
.vscode/
.beads

# Python byproducts (scripts/)
__pycache__/
*.pyc

# per-checkout policy and repo-local intent: they name owners and a product's own terms, so they are never committed here
.beadle/propose-only.yaml
.beadle/intent.yaml
